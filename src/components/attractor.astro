<canvas id="attractor-canvas"></canvas>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.getElementById('attractor-canvas') as HTMLCanvasElement | null;

  const isLowPower = (() => {
    const cores = navigator.hardwareConcurrency || 4;
    const nav = navigator as unknown as { deviceMemory?: number };
    const mem = typeof nav.deviceMemory === 'number' ? nav.deviceMemory : 4;
    return cores <= 4 || mem <= 4;
  })();

  const isSmallScreen = window.innerWidth < 900;
  const quality = prefersReducedMotion
    ? 'low'
    : isLowPower
      ? 'low'
      : isSmallScreen
        ? 'medium'
        : 'high';

  const config = {
    particleBudget: quality === 'low' ? 180 : quality === 'medium' ? 240 : 320,
    trailLength: quality === 'low' ? 36 : quality === 'medium' ? 52 : 80,
    fpsCap: quality === 'low' ? 40 : quality === 'medium' ? 33 : 30,
  };

  if (canvas && !prefersReducedMotion && typeof OffscreenCanvas !== 'undefined') {
    const landingSection = document.querySelector('.landing') as HTMLElement;
    const titleEl        = document.getElementById('landing-name');

    if (landingSection) {
      canvas.style.opacity = '0';

      const worker = new Worker('/portfolio/attractor-worker.js');

      function getCenter(cw: number, ch: number) {
        const isMobile = cw < 600;
        const landingRect = landingSection.getBoundingClientRect();
        if (!isMobile && titleEl) {
          const titleRect = titleEl.getBoundingClientRect();
          return {
            cxRatio: ((titleRect.right - landingRect.left) - 20) / landingRect.width,
            cyRatio: ((titleRect.top - landingRect.top) + titleRect.height / 2 + 20) / landingRect.height,
            mobile: false,
          };
        }
        return { cxRatio: 0.5, cyRatio: 0.5, mobile: true };
      }

      function getDims() {
        const rect = landingSection.getBoundingClientRect();
        const dpr  = window.devicePixelRatio || 1;
        return {
          width:  rect.width  * dpr,
          height: rect.height * dpr,
          cssW:   rect.width,
          cssH:   rect.height,
          dpr,
        };
      }

      const dims = getDims();
      canvas.width  = dims.width;
      canvas.height = dims.height;
      canvas.style.width  = `${dims.cssW}px`;
      canvas.style.height = `${dims.cssH}px`;

      const offscreen = canvas.transferControlToOffscreen();
      const center = getCenter(dims.cssW, dims.cssH);

      worker.postMessage({
        type:   'init',
        canvas: offscreen,
        width:  dims.width,
        height: dims.height,
        devicePixelRatio: dims.dpr,
        cxRatio: center.cxRatio,
        cyRatio: center.cyRatio,
        mobile: center.mobile,
        config,
      }, [offscreen]);

      let lastCssW = dims.cssW;
      let lastCssH = dims.cssH;
      let lastDpr  = dims.dpr;
      let lastVisualScale = window.visualViewport?.scale ?? 1;
      let lastViewportW = window.visualViewport?.width ?? window.innerWidth;
      let lastViewportH = window.visualViewport?.height ?? window.innerHeight;
      let lastInnerW = window.innerWidth;
      let lastInnerH = window.innerHeight;
      let lastOuterW = window.outerWidth;
      let lastOuterH = window.outerHeight;
      let lastDevicePixelRatio = window.devicePixelRatio;
      let resizeFrame: number | null = null;

      const handleResize = () => {
        if (resizeFrame !== null) return;
        resizeFrame = requestAnimationFrame(() => {
          resizeFrame = null;
          const d = getDims();
          const scale = window.visualViewport?.scale ?? 1;
          const viewportW = window.visualViewport?.width ?? window.innerWidth;
          const viewportH = window.visualViewport?.height ?? window.innerHeight;
          const innerW = window.innerWidth;
          const innerH = window.innerHeight;
          const outerW = window.outerWidth;
          const outerH = window.outerHeight;
          const devicePixelRatio = window.devicePixelRatio;
          if (d.cssW === lastCssW && d.cssH === lastCssH && d.dpr === lastDpr && scale === lastVisualScale && viewportW === lastViewportW && viewportH === lastViewportH && innerW === lastInnerW && innerH === lastInnerH && outerW === lastOuterW && outerH === lastOuterH && devicePixelRatio === lastDevicePixelRatio) return;
          lastCssW = d.cssW;
          lastCssH = d.cssH;
          lastDpr = d.dpr;
          lastVisualScale = scale;
          lastViewportW = viewportW;
          lastViewportH = viewportH;
          lastInnerW = innerW;
          lastInnerH = innerH;
          lastOuterW = outerW;
          lastOuterH = outerH;
          lastDevicePixelRatio = devicePixelRatio;
          const center = getCenter(d.cssW, d.cssH);
          worker.postMessage({ type: 'resize', width: d.width, height: d.height,
            devicePixelRatio: d.dpr,
            cxRatio: center.cxRatio,
            cyRatio: center.cyRatio,
            mobile: center.mobile });
        });
      };

      const zoomCheck = () => {
        const scale = window.visualViewport?.scale ?? 1;
        const viewportW = window.visualViewport?.width ?? window.innerWidth;
        const viewportH = window.visualViewport?.height ?? window.innerHeight;
        const innerW = window.innerWidth;
        const innerH = window.innerHeight;
        const outerW = window.outerWidth;
        const outerH = window.outerHeight;
        const devicePixelRatio = window.devicePixelRatio;
        const d = getDims();
        if (scale !== lastVisualScale || viewportW !== lastViewportW || viewportH !== lastViewportH || innerW !== lastInnerW || innerH !== lastInnerH || outerW !== lastOuterW || outerH !== lastOuterH || devicePixelRatio !== lastDevicePixelRatio || d.cssW !== lastCssW || d.cssH !== lastCssH || d.dpr !== lastDpr) {
          handleResize();
        }
      };
      const zoomPoll = window.setInterval(zoomCheck, 250);

      window.addEventListener('resize', handleResize);
      window.visualViewport?.addEventListener('resize', handleResize);
      window.visualViewport?.addEventListener('scroll', handleResize);
      window.addEventListener('beforeunload', () => window.clearInterval(zoomPoll));

      document.addEventListener('visibilitychange', () => {
        worker.postMessage({ type: 'visible', value: !document.hidden });
      });


      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          worker.postMessage({ type: 'visible', value: entry.isIntersecting });
        });
      }, { threshold: 0.1 });

      observer.observe(landingSection);
    }

  } else if (canvas && !prefersReducedMotion) {
    const ctx = canvas.getContext('2d');
    const landingSection = document.querySelector('.landing') as HTMLElement;
    const titleEl = document.getElementById('landing-name');

    if (ctx && landingSection) {
      let isVisible = false;
      let animationFrameId: number;
      let lastTime = performance.now();
      let accumulator = 0;
      canvas.style.opacity = '0';

      const sigma = 10, rho = 28, beta = 8 / 3, dt = 0.0012;
      const particleBudget = quality === 'low' ? 140 : quality === 'medium' ? 220 : 300;
      const trailLength = quality === 'low' ? 24 : quality === 'medium' ? 40 : 60;
      const simInterval = quality === 'low' ? 48 : 32;

      const particles: Array<{ x: number; y: number; z: number; history: {x:number,y:number}[] }> = [];
      for (let i = 0; i < particleBudget; i++) {
        let rx = Math.random()*30-15, ry = Math.random()*30-15, rz = Math.random()*30+10;
        for (let j = 0; j < 2500; j++) {
          rx += sigma*(ry-rx)*dt; ry += (rx*(rho-rz)-ry)*dt; rz += (rx*ry-beta*rz)*dt;
        }
        particles.push({ x: rx, y: ry, z: rz, history: [] });
      }

      function resizeCanvas() {
        const rect = landingSection.getBoundingClientRect();
        const dpr  = window.devicePixelRatio || 1;
        canvas!.width  = rect.width  * dpr;
        canvas!.height = rect.height * dpr;
        canvas!.style.width  = `${rect.width}px`;
        canvas!.style.height = `${rect.height}px`;
        ctx!.setTransform(1, 0, 0, 1, 0, 0);
        ctx!.scale(dpr, dpr);
      }
      window.addEventListener('resize', resizeCanvas);
      window.visualViewport?.addEventListener('resize', resizeCanvas);
      window.visualViewport?.addEventListener('scroll', resizeCanvas);
      resizeCanvas();

      function draw(now = performance.now()) {
        if (!isVisible) return;
        const dpr = window.devicePixelRatio || 1;
        const cw  = canvas!.width / dpr, ch = canvas!.height / dpr;
        const delta = Math.min(now - lastTime, 100);
        lastTime = now;
        accumulator += delta;
        ctx!.clearRect(0, 0, cw, ch);

        let cx = cw/2, cy = ch/2;
        const mob = cw < 768;
        if (!mob && titleEl) {
          const tr = titleEl.getBoundingClientRect();
          const lr = landingSection.getBoundingClientRect();
          cx = (tr.right - lr.left) - 20;
          cy = (tr.top - lr.top) + tr.height/2 + 20;
        }

        if (accumulator >= simInterval) {
          particles.forEach(p => {
            p.x += sigma*(p.y-p.x)*dt;
            p.y += (p.x*(rho-p.z)-p.y)*dt;
            p.z += (p.x*p.y-beta*p.z)*dt;
            p.history.push({x:p.x, y:p.y});
            if (p.history.length > trailLength) p.history.shift();
          });
          accumulator -= simInterval;
        }

        let g = mob
          ? (() => { const g = ctx!.createLinearGradient(0,0,cw,0); g.addColorStop(0,'rgba(0,255,157,.12)'); g.addColorStop(.5,'rgba(0,255,157,.18)'); g.addColorStop(1,'rgba(0,255,157,.12)'); return g; })()
          : (() => { const g = ctx!.createLinearGradient(cx-250,0,cx+350,0); g.addColorStop(0,'rgba(0,255,157,1)'); g.addColorStop(.4,'rgba(0,255,157,.45)'); g.addColorStop(1,'rgba(0,255,157,.01)'); return g; })();

        ctx!.strokeStyle = g; ctx!.lineWidth = quality === 'low' ? 0.65 : 0.85; ctx!.beginPath();
        particles.forEach(p => {
          if (p.history.length < 2) return;
          ctx!.moveTo(cx + p.history[0].x*11.5, cy + p.history[0].y*11.5);
          for (let j = 1; j < p.history.length; j++) {
            const sx = cx + p.history[j].x*11.5, sy = cy + p.history[j].y*11.5;
            const px2 = cx + p.history[j-1].x*11.5;
            Math.abs(px2-sx) < cw/4 ? ctx!.lineTo(sx,sy) : ctx!.moveTo(sx,sy);
          }
        });
        ctx!.stroke();
        animationFrameId = requestAnimationFrame(draw);
      }

      const obs = new IntersectionObserver(entries => {
        entries.forEach(e => {
          isVisible = e.isIntersecting;
          if (isVisible) { lastTime = performance.now(); accumulator = 0; draw(); }
          else cancelAnimationFrame(animationFrameId);
        });
      }, { threshold: 0.1 });
      obs.observe(landingSection);
    }
  }
</script>

<style>
  #attractor-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 1;
    pointer-events: none;
    mix-blend-mode: screen;
    will-change: transform;
  }
</style>